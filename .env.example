DATABASE_URL=postgresql+psycopg://copilot:copilot-dev-only@localhost:5432/copilot
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
# Local Docker Neo4j (default). For Neo4j Aura the connection URI is
# neo4j+s://<instance>.databases.neo4j.io and NEO4J_USER is the AuraDB
# instance ID (e.g. 70671a34), not "neo4j"; use the generated password.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=copilot-dev-only
DATASET_ROOT=./dataset
ANALYSIS_DATE=2026-10-17
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Generative UI. The copilot model above owns the facts; this model only composes the
# layout of an already validated answer and may never supply a value.
# Point OPENUI_BASE_URL at any OpenAI-compatible endpoint that writes OpenUI Lang:
#   * vLLM serving thesysdev/OUI-1 (recommended, needs a GPU):
#       vllm serve thesysdev/OUI-1 --port 8080
#       OPENUI_BASE_URL=http://localhost:8080/v1
#   * OpenUI Gateway (no GPU, not OUI-1):
#       npx @openuidev/cli@latest generate-api-key
#       OPENUI_BASE_URL=https://api.thesys.dev/v1/embed
#       OPENUI_MODEL=<provider>/<model>
#       OPENUI_API_KEY=$THESYS_API_KEY
# When it is unreachable or off, the workspace renders the deterministic answer instead.
# The Gateway defaults below need no GPU; swap OPENUI_MODEL for any catalog id
# (https://www.openui.com/cloud/gateway/models) and keep the key on the server.
OPENUI_ENABLED=1
OPENUI_BASE_URL=https://api.thesys.dev/v1/embed
OPENUI_MODEL=google/gemini-3.6-flash-free
OPENUI_API_KEY=
OPENUI_SPEC_PATH=frontend/lib/generated/ui-spec.json
OPENUI_TIMEOUT_SECONDS=30

# Observability (Reliability Monitoring). This one is read by the BROWSER, so it is a
# client key (pk-th-…), created under Console > Client API keys, and it must live in
# frontend/.env.local as NEXT_PUBLIC_OPENUI_API_KEY. Never put a server key (sk-th-…) here
# or in any frontend file. frontend/.gitignore already ignores .env.*, and the value is
# safe to expose: the SDK only reports telemetry.
NEXT_PUBLIC_OPENUI_API_KEY=
