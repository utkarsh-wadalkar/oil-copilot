DATABASE_URL=postgresql+psycopg://copilot:copilot-dev-only@localhost:5432/copilot
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
# Local Docker Neo4j (default). For Neo4j Aura the connection URI is
# neo4j+s://<instance>.databases.neo4j.io and NEO4J_USER is the AuraDB
# instance ID (e.g. 70671a34), not "neo4j"; use the generated password.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=copilot-dev-only
DATASET_ROOT=./dataset
ANALYSIS_DATE=2026-10-17
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
