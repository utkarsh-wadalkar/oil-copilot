# Non-secret env template for the nao sidecar. Tracked; contains NO secrets.
# Secrets live in the git-ignored data/nao-secrets.env written by
# secrets/generate_nao_secrets.py (env_file of the `nao` service).

MODE=prod
NAO_MODE=self-hosted
NAO_CONTEXT_SOURCE=local
NAO_STORAGE_BACKEND=none
NAO_DEFAULT_PROJECT_PATH=/nao-project
DB_URI=sqlite:/app/data/nao-metadata.db
BETTER_AUTH_URL=http://nao:5005
ENABLE_USER_LOGIN=true
ENABLE_USER_SIGNUP=false
MCP_ENDPOINT_ENABLED=true
# MCP server (declared in the read-only project's agent/mcps/mcp.json) that
# receives a per-invocation signed actor capability header on every tool call.
COPILOT_ASSET_SERVER=asset-knowledge

# Provide these through the private env_file (never commit real values):
#   BETTER_AUTH_SECRET          stable 32-byte base64/hex string
#   COPILOT_MCP_SECRET          shared HMAC secret with the FastAPI backend
#   OLLAMA_API_KEY              https://ollama.com API key for gemma4:31b
