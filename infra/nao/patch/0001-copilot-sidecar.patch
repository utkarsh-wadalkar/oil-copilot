+	/** Whether this server is the Copilot Asset Knowledge MCP, which takes a per-call signed actor. */
+	private _isCopilotAssetServer(server: string): boolean {
+		return Boolean(env.COPILOT_ASSET_SERVER) && server === env.COPILOT_ASSET_SERVER;
+	}
+
+	/**
+	 * Calls the Copilot Asset Knowledge MCP with a short-lived capability that binds THIS trusted
+	 * (projectId, userId) pair to the invocation. The capability is minted per call from the run's
+	 * context — never from model arguments, and never from shared mutable header config — so a run
+	 * cannot call as another user and a spoofed `user_id` in tool arguments is ignored.
+	 */
+	private async _callToolSignedActor(opts: {
+		projectId: string;
+		userId: string;
+		server: string;
+		tool: string;
+		args: Record<string, unknown>;
+		config: McpServerConfig;
+	}): Promise<unknown> {
+		const { projectId, userId, server, tool, args, config } = opts;
+		const secret = env.COPILOT_MCP_SECRET;
+		if (!secret) {
+			throw new Error('COPILOT_MCP_SECRET is not configured; cannot call the Asset Knowledge MCP.');
+		}
+		const capability = await new SignJWT({ project_id: projectId })
+			.setProtectedHeader({ alg: 'HS256', typ: 'JWT' })
+			.setIssuer('nao-sidecar')
+			.setAudience(server)
+			.setSubject(userId)
+			.setIssuedAt()
+			.setJti(crypto.randomUUID())
+			.setExpirationTime('60s')
+			.sign(new TextEncoder().encode(secret));
+		const headers = {
+			...(config.headers ?? {}),
+			Authorization: `Bearer ${capability}`,
+			'X-Nao-Actor-Capability': capability,
+		};
+		return this._withHttpClient(config, headers, (client) => client.callTool({ name: tool, arguments: args }));
+	}
